// 说书人普拉斯的联机中转：每个房间一个 Durable Object
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storyteller-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // 推送通知的公钥；私钥用 `wrangler secret put VAPID_PRIVATE_JWK` 设置（本地开发放在 .dev.vars）
  "vars": { "VAPID_PUBLIC": "BLO5_mgN3n0Hyp6V9z8J8FwwCrfg7eY5C5t0HDar3LfyvBnhC-T1-_AEnS4X7j4Qj74bTYiy_nxyZppmC_NUvdc" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
